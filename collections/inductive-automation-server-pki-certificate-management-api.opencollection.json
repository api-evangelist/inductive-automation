{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ignition Gateway REST access-control server-pki-certificate-management API",
    "version": "8.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Ignition-API-Token",
      "value": "{{X-Ignition-API-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "server-pki-certificate-management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Rejected Server Certificates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{gateway-host}:{port}/data/opc-ua/api/v1/server/pki/certificates/rejected"
          },
          "docs": "A list of all rejected server certificates."
        },
        {
          "info": {
            "name": "Download Rejected Server Certificate",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{gateway-host}:{port}/data/opc-ua/api/v1/server/pki/certificates/rejected/:signature",
            "params": [
              {
                "name": "signature",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Download a rejected server certificate with the given signature."
        },
        {
          "info": {
            "name": "Delete Rejected Server Certificate",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://{gateway-host}:{port}/data/opc-ua/api/v1/server/pki/certificates/rejected/:signature",
            "params": [
              {
                "name": "signature",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a rejected server certificate with the given signature."
        },
        {
          "info": {
            "name": "Get Trusted Server Certificates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{gateway-host}:{port}/data/opc-ua/api/v1/server/pki/certificates/trusted"
          },
          "docs": "A list of all trusted server certificates."
        },
        {
          "info": {
            "name": "Upload Trusted Server Certificates",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://{gateway-host}:{port}/data/opc-ua/api/v1/server/pki/certificates/trusted"
          },
          "docs": "Upload a trusted server certificate."
        },
        {
          "info": {
            "name": "Download Trusted Server Certificate",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{gateway-host}:{port}/data/opc-ua/api/v1/server/pki/certificates/trusted/:signature",
            "params": [
              {
                "name": "signature",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Download a trusted server certificate with the given signature."
        },
        {
          "info": {
            "name": "Trust Rejected Server Certificate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://{gateway-host}:{port}/data/opc-ua/api/v1/server/pki/certificates/trusted/:signature",
            "params": [
              {
                "name": "signature",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Trust a previously rejected server certificate with the given signature."
        },
        {
          "info": {
            "name": "Delete Trusted Server Certificate",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://{gateway-host}:{port}/data/opc-ua/api/v1/server/pki/certificates/trusted/:signature",
            "params": [
              {
                "name": "signature",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a trusted server certificate with the given signature."
        }
      ]
    }
  ],
  "bundled": true
}