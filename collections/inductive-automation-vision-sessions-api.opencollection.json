{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ignition Gateway REST access-control vision-sessions API",
    "version": "8.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Ignition-API-Token",
      "value": "{{X-Ignition-API-Token}}",
      "placement": "header"
    }
  },
  "items": [
