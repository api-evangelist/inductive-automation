{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ignition Gateway REST access-control gateway-info API",
    "version": "8.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Ignition-API-Token",
      "value": "{{X-Ignition-API-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "gateway-info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Gateway Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{gateway-host}:{port}/data/api/v1/gateway-info"
          },
          "docs": "Information about this gateway."
        }
      ]
    }
  ],
  "bundled": true
}