{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ignition Gateway REST access-control encryption API",
    "version": "8.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Ignition-API-Token",
      "value": "{{X-Ignition-API-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "encryption",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Encrypt arbitrary bytes",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://{gateway-host}:{port}/data/api/v1/encryption/encrypt",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Encrypt an arbitrary payload into a flat JSON Web Encryption structure suitable for embedding as a secret in resource configs."
        }
      ]
    }
  ],
  "bundled": true
}