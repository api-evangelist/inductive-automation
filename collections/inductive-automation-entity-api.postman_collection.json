          "name": "Browse Entities",
          "request": {
            "name": "Browse Entities",
            "description": {
              "content": "This endpoint returns a list of matching registered entities, including children up to the depth specified.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data",
                "api",
                "v1",
                "entity",
                "browse"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "path",
                  "value": "<string>",
                  "description": "Path to a specific entity to browse. Use '/' to separate path components."
                },
                {
                  "disabled": false,
                  "key": "depth",
                  "value": "<string>",
                  "description": "The depth to browse to. Default is 1."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<string>",
                  "description": "When listing children, the limit of children to return. Default is 10. Zero means unlimited"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<string>",
                  "description": "When listing children, the number of children to skip. Default is 0."
                }
              ],
              "variable": [
                {
                  "description": "Hostname or IP address of the Ignition Gateway",
                  "type": "any",
                  "value": "{{gateway-host}}",
                  "key": "gateway-host"
                },
                {
                  "description": "Gateway HTTP port (default 8088; HTTPS default 8043)",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
