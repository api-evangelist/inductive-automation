        {
          "id": "c738114c-9bde-4f1b-8898-70f550fe8296",
          "name": "Restore Gateway Backup",
          "request": {
            "name": "Restore Gateway Backup",
            "description": {
              "content": "Processes and restores a *.gwbk file on this gateway. The gateway will then be restarted.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data",
                "api",
                "v1",
                "backup"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "restoreDisabled",
                  "value": "<string>",
                  "description": "If `true`, all projects, database connections, OPC connections, etc will be disabled upon restart. Default is `false`"
                },
                {
                  "disabled": false,
                  "key": "disableTempProjectBackup",
                  "value": "<string>",
                  "description": "If `true`, the projects dir will not have a temporary backup created during the restore process. Default is `false`"
                },
                {
                  "disabled": false,
                  "key": "renameEnabled",
                  "value": "<string>",
                  "description": "If `true` will allow overriding the name of the gateway before it is restored. Default is `false`"
                },
                {
                  "disabled": false,
                  "key": "newName",
                  "value": "<string>",
                  "description": "The new gateway name to use on restore."
                },
                {
                  "disabled": false,
                  "key": "restoreLocal",
                  "value": "<string>",
                  "description": "Set this parameter to `true` to restore local-specific files on the gateway. These files will be restored to the\ndata/config/local folder and the data/config/resources/local folder. Note that existing files in these folders\nwill be deleted. Default value is `false`.\n"
                }
              ],
              "variable": [
                {
                  "description": "Hostname or IP address of the Ignition Gateway",
                  "type": "any",
                  "value": "{{gateway-host}}",
                  "key": "gateway-host"
                },
                {
                  "description": "Gateway HTTP port (default 8088; HTTPS default 8043)",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
