{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ignition Gateway REST access-control secret-providers API",
    "version": "8.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Ignition-API-Token",
      "value": "{{X-Ignition-API-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "secret-providers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Provider Secrets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{gateway-host}:{port}/data/api/v1/secret-providers/:provider-name/secrets",
            "params": [
              {
                "name": "provider-name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Discover the list of secrets managed by a provider."
        }
      ]
    }
  ],
  "bundled": true
}